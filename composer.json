{
    "name": "thesis/etcd-api",
    "description": "Generated PHP client for etcd v3 gRPC API.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesis-php/people"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "amphp/amp": "^3.1",
        "thesis/grpc-client": "^0.2",
        "thesis/grpc-protocol": "^0.2",
        "thesis/protobuf": "^0.2",
        "thesis/protoregistry": "^0.1.2"
    },
    "autoload": {
        "psr-4": {
            "Authpb\\": "src/Authpb",
            "Etcdserverpb\\": "src/Etcdserverpb",
            "Mvccpb\\": "src/Mvccpb",
            "V3electionpb\\": "src/V3electionpb",
            "V3lockpb\\": "src/V3lockpb"
        },
        "files": [
            "src/Authpb/autoload.metadata.php",
            "src/Etcdserverpb/autoload.metadata.php",
            "src/Mvccpb/autoload.metadata.php",
            "src/V3electionpb/autoload.metadata.php",
            "src/V3lockpb/autoload.metadata.php"
        ]
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
